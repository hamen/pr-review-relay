#!/usr/bin/env bash
# pr-review-relay — hand a PR off to the OTHER agents for cross-review.
#
# Whoever created the PR calls this with --author <self>. The other agents
# (claude / codex / cursor / antigravity / opencode / qwen / grok) review the PR headless
# and post their review as a PR comment. The author auto-excludes itself.
# NB "read-only" is ENFORCED for opencode, grok and claude; codex, antigravity and cursor are
# asked, not confined. Claude's plan mode refuses writes but NOT read-only commands.
# See the caveats in the README.
#
# The diff always comes from `gh pr diff` (authoritative — matches GitHub, handles forks —
# and just one cheap subprocess). The speed win is the CONTEXT reads: when the relay runs
# from the PR's own checkout (the usual case) AND that checkout provably is the PR head and
# is clean, reviewers are told to read the changed files straight off disk instead of
# fetching via `gh` themselves — every `gh` an agentic reviewer runs is an LLM round-trip,
# the main cause of slow-model timeouts. If the tree isn't the PR head, is dirty, or we're
# run from elsewhere, reviewers fetch via `gh pr view/diff` as before. Either way `gh` still
# POSTS the reviews — the consensus trail on the PR. Pass --diff for the older diff-on-stdin
# behaviour. Pass --context-file <path> to prepend a document (docs, specs, API references)
# that every reviewer must read and verify against.
#
# Each review is posted COLLAPSED (<details>/<summary>, forum-style hide/show)
# so the PR page stays clean — expand a comment to read it. After consensus,
# put the synthesized work card in the PR description with pr-review-consensus.
#
# EVIDENCE. Every run writes a timestamped log plus one sidecar per reviewer under the round-state
# dir, and the path is printed at STARTUP (not just in the closing banner, which a killed run never
# reaches). Each reviewer's stdout streams straight into its own sidecar as the CLI produces it, so
# when the relay is killed mid-round — which happens, and the cause has been outside this script
# every time it was chased — you still have: which reviewers were dispatched, which finished, and
# whatever partial text the one in flight had produced. One writer per file, so nothing interleaves
# under --parallel and no locking is needed. See "Evidence and forensics" in the README.
#
# Usage:
#   pr-review-relay [--author claude|codex|cursor|antigravity|opencode|qwen|grok] [--pr <number|url>] \
#                   [--reviewers claude,codex,cursor,antigravity] [--parallel] \
#                   (opencode, qwen, and grok are also supported, opt-in: name them explicitly)
#                   [--context-file <path>] [--diff] [--dry-run]
#   (no --pr → uses the PR for the current branch; run from inside the repo)
#
# Fail-closed exit codes (so callers can trust the outcome, not just the banner):
#   0  every reviewer that ran produced AND posted a review; PR head did not move.
#      NOTE: this means everyone RAN — not that the PR is approved. You still must
#      read the reviews and resolve every Blocker/Should-fix before merging.
#   3  not a clean round: a reviewer returned empty / timed out / exited non-zero /
#      failed to post, OR an explicitly-requested reviewer was missing, OR no
#      reviewer ran, OR HEAD moved during the round (reviews now describe stale code).
#   4  a loop cap was reached — stop looping and escalate to a human. TWO caps exit 4 and the
#      message says which fired: the ROUND cap (--max-rounds, counted per reviewed SHA) and the
#      SAME-SHA cap (PR_RELAY_MAX_SAME_SHA, dispatches on one unchanged SHA).
#   1/2 usage or precondition error (no gh, no PR, empty diff, bad arg).
# A missing CLI from the DEFAULT reviewer set is a tolerated skip; only reviewers
# named explicitly via --reviewers are required to be present.
set -uo pipefail

# SCRIPT_DIR must be the directory of the REAL script, so the sibling library and helper
# resolve even when the script is invoked through a symlink (e.g. ~/.local/bin/pr-review-relay
# -> the repo checkout). `pwd -P` resolves a symlinked *directory* but NOT a symlinked
# *script file*, so we first walk the script's own symlink chain to the real file.
# `dirname`/`$0` are still avoided (they'd resolve through PATH before the PATH guard runs,
# letting a repo-local tool pick which library we source). A builtin can't read a symlink
# target, so readlink is used — but at an ABSOLUTE path, never via PATH, which keeps that
# guarantee. The loop only runs when the script is actually a symlink, and is bounded
# against a symlink cycle.
_self="${BASH_SOURCE[0]}"
_rl=/usr/bin/readlink; [ -x "$_rl" ] || _rl=/bin/readlink
_n=0
while [ -h "$_self" ] && [ -x "$_rl" ] && [ "$_n" -lt 40 ]; do
  _n=$((_n + 1))
  _link="$("$_rl" "$_self" 2>/dev/null)" || break
  case "$_link" in
    /*) _self="$_link";;                # absolute symlink target
    *)  case "$_self" in
          */*) _self="${_self%/*}/$_link";;  # relative target → resolve against the link's dir
          *)   _self="$_link";;              # bare name (no dir) → target is relative to cwd
        esac;;
  esac
done
# Fail CLOSED: if it's STILL a symlink, we couldn't resolve it (readlink missing, or a
# cycle). Do NOT fall through to source a lib next to the *link* — that's the very bug this
# fixes, and a repo-local lib there would defeat the PATH guard. Error clearly instead.
if [ -h "$_self" ]; then
  echo "cannot resolve the script's own symlink (readlink unavailable or a symlink cycle): $_self" >&2
  exit 1
fi
case "$_self" in
  */*) SCRIPT_DIR="${_self%/*}";;
  *)   SCRIPT_DIR=".";;
esac
# `cd --` so a dir that begins with '-' isn't read as an option (or, for '-', as $OLDPWD).
SCRIPT_DIR="$(cd -- "$SCRIPT_DIR" 2>/dev/null && pwd -P)" || { echo "cannot resolve script directory" >&2; exit 1; }
unset _self _rl _n _link
WRAP_COMMENT="$SCRIPT_DIR/wrap-collapsed-pr-comment.mjs"
# The OpenCode reviewer lives in a shared lib so its policy cannot drift between
# this script and review-local — cross-review flagged that duplication repeatedly.
OPENCODE_LIB="$SCRIPT_DIR/lib-opencode.sh"
[ -r "$OPENCODE_LIB" ] || { echo "missing $OPENCODE_LIB (keep it next to this script)" >&2; exit 1; }
. "$OPENCODE_LIB"
GROK_LIB="$SCRIPT_DIR/lib-grok.sh"
[ -r "$GROK_LIB" ] || { echo "missing $GROK_LIB (keep it next to this script)" >&2; exit 1; }
. "$GROK_LIB"

AUTHOR=""; PR=""; REVIEWERS="claude,codex,cursor,antigravity"; PARALLEL=0; DRY=0; MAX_ROUNDS="${PR_RELAY_MAX_ROUNDS:-3}"; RESET=0; AGENT_TIMEOUT="${PR_RELAY_AGENT_TIMEOUT:-300}"
# Validate here rather than letting `timeout` fail with a bare exit 125.
case "$AGENT_TIMEOUT" in ''|*[!0-9]*|0) echo "invalid PR_RELAY_AGENT_TIMEOUT: '$AGENT_TIMEOUT' (want a positive number of seconds)" >&2; exit 2;; esac

# Second loop guard, alongside --max-rounds. The round counter now advances only when the PR head
# SHA CHANGES (see the round-state block below), which is what makes splitting a panel across
# several invocations free — the workaround you need when the relay keeps dying mid-round. That
# alone would leave a same-SHA loop unbounded, so dispatches on one unchanged SHA get their own cap.
# Default 6 covers the realistic worst case: a 3-reviewer panel run one reviewer at a time, with one
# retry each. Validated exactly like MAX_ROUNDS below — which ACCEPTS 0 (meaning "always at cap");
# AGENT_TIMEOUT rejects 0 instead, because there `timeout 0` disables the limit rather than
# tightening it.
MAX_SAME_SHA="${PR_RELAY_MAX_SAME_SHA:-6}"
case "$MAX_SAME_SHA" in ''|*[!0-9]*) echo "invalid PR_RELAY_MAX_SAME_SHA: '$MAX_SAME_SHA' (want a non-negative integer)" >&2; exit 2;; esac
# Cap on a single reviewer's captured output. Applied on the WRITE path (see review_with), not just
# to what is read back, so a runaway agent cannot fill the disk before AGENT_TIMEOUT fires. The
# truncation is deliberate backpressure: `head` closing early sends SIGPIPE to the agent.
# It does NOT bound the run log itself, which only ever holds short event lines.
LOG_MAX_BYTES="${PR_RELAY_LOG_MAX_BYTES:-262144}"
case "$LOG_MAX_BYTES" in ''|*[!0-9]*|0) echo "invalid PR_RELAY_LOG_MAX_BYTES: '$LOG_MAX_BYTES' (want a positive number of bytes)" >&2; exit 2;; esac

# Pin the Cursor reviewer's model. Left unset, `cursor-agent` falls back to whatever
# ~/.cursor/cli-config.json holds — typically "Auto", which routes to the frontier models.
# That is wrong here for two reasons, and the second one is the serious one:
#   1. Auto bills against Cursor's "Other Models" quota (Claude/GPT), a much smaller pool than
#      the Cursor-branded one. A relay running on every PR drains it mid-cycle.
#   2. Auto is free to pick a Claude model. A PR written by Claude would then be reviewed by
#      Claude wearing a Cursor badge — the panel reads as N independent reviewers while two of
#      them are the same model. Cross-review is only worth running on distinct models.
# composer-2.5 is Cursor's own model: Cursor-pool, and not Claude, GPT, Codex or Grok — so each
# reviewer in the panel stays on the model its own vendor built. That last part matters once the
# opt-in `grok` reviewer is in the panel: a Cursor-branded Grok would put two Grok-family readers
# in a panel that claims two independent ones, which is the same defect as Auto picking Claude,
# just one row down.
# An unknown id is safe as of cursor-agent 2026.07: it exits 1 and puts the error on stderr,
# leaving stdout empty, so the fail-closed path below reports a failed reviewer. That rests on
# stdout being empty — a non-zero exit WITH output is still posted (marked unclean).
# Same value in review-local and pr-review-distill; the tests assert all three.
CURSOR_REVIEW_MODEL="${CURSOR_REVIEW_MODEL:-composer-2.5}"

# Codex and antigravity took their model from their own global config, so the only
# way to review a PR with a specific model was to edit that config — which changes
# every other use of the CLI too. Both now accept an override, matching what cursor
# and grok already had. Left unset, each keeps reading its own config exactly as
# before.
#   CODEX_REVIEW_MODEL=gpt-5.6  CODEX_REVIEW_EFFORT=high
#   AGY_REVIEW_MODEL=gemini-3.1-pro-high
CODEX_REVIEW_MODEL="${CODEX_REVIEW_MODEL:-}"
CODEX_REVIEW_EFFORT="${CODEX_REVIEW_EFFORT:-}"
AGY_REVIEW_MODEL="${AGY_REVIEW_MODEL:-}"

# Claude was the last reviewer taking BOTH its model and its permissions from ambient config: a
# bare `claude -p`. Every other seat is pinned on the command line, and #15/#17 pinned cursor for
# exactly this reason — a review whose model can change under you reports nothing when it does.
# So this default is HARD (cursor's shape), not opt-in (codex's): an empty default would ship
# override support while leaving the drift in place for every existing install.
#
# `opus` is a FAMILY ALIAS, so it still tracks the newest Opus. It pins the tier — the thing that
# moves when the machine's default changes — not a frozen build. A frozen id would go stale and
# start failing; CURSOR_REVIEW_MODEL carries the same tradeoff, and the same "change it if the id
# is retired" applies here.
#
# The fallback is LOAD-BEARING, not a courtesy. Measured on claude 2.1.220: an unavailable model
# (no entitlement, over quota, retired id) prints "There's an issue with the selected model …" on
# STDOUT and exits 1, with stderr EMPTY. As the cursor note above spells out, a non-zero exit WITH
# output is still posted (the round is only marked unclean) — so without a fallback that error text
# lands on the PR under a "Claude review" header and the round is burnt. Cursor's unknown id is
# safe because its error goes to stderr and stdout stays empty; claude's does the opposite.
# The fallback turns a guaranteed-wasted round into a real review. This repo is public — most
# installs are not on the account that chose `opus`.
# RESIDUAL: if the fallback model fails the same way, the error text is still what gets posted.
CLAUDE_REVIEW_MODEL="${CLAUDE_REVIEW_MODEL:-opus}"
CLAUDE_REVIEW_EFFORT="${CLAUDE_REVIEW_EFFORT:-}"
CLAUDE_REVIEW_FALLBACK_MODEL="${CLAUDE_REVIEW_FALLBACK_MODEL:-sonnet}"

# Built as arrays, not strings: an empty override must add NO argument at all,
# whereas an unquoted empty string would be passed along as one.
# Expanded as ${arr[@]+"${arr[@]}"} at the call sites: Bash 3.2 (what macOS ships)
# aborts on "${arr[@]}" for an EMPTY array under `set -u`, which is the common case
# here since both overrides are normally unset. Same guard lib-opencode.sh uses.
CODEX_MODEL_ARGS=()
[ -n "$CODEX_REVIEW_MODEL" ] && CODEX_MODEL_ARGS+=(-m "$CODEX_REVIEW_MODEL")
[ -n "$CODEX_REVIEW_EFFORT" ] && CODEX_MODEL_ARGS+=(-c "model_reasoning_effort=\"$CODEX_REVIEW_EFFORT\"")
AGY_MODEL_ARGS=()
[ -n "$AGY_REVIEW_MODEL" ] && AGY_MODEL_ARGS+=(--model "$AGY_REVIEW_MODEL")
# Model and fallback are hard-defaulted above, so they are always present; effort is opt-in and
# must add NO argument when empty — same empty-array guard as the two arrays above.
# `--permission-mode plan` blocks writes and mutating commands. It does NOT block read-only ones:
# measured, `git --version` and `gh pr diff` RUN under it while `touch` is refused. That is what
# the link-mode prompt needs (it tells the reviewer to fetch the PR itself), and it is why the
# residual in the README is a network-capable READ channel, not "no commands".
# `--safe-mode` is the other half: plan mode does not stop a checkout-controlled
# .claude/settings.json hook from running at session start. It also stops a PR-controlled
# CLAUDE.md from loading as INSTRUCTIONS — while the prompt below asks the reviewer to read it as
# DATA, which is the correct posture for a diff whose author you do not trust.
# review-local deliberately does NOT get these two: it reviews your own branch, where disabling
# your own CLAUDE.md, hooks and MCP would cost quality against a threat that isn't there.
CLAUDE_MODEL_ARGS=(--model "$CLAUDE_REVIEW_MODEL" --fallback-model "$CLAUDE_REVIEW_FALLBACK_MODEL" --permission-mode plan --safe-mode)
[ -n "$CLAUDE_REVIEW_EFFORT" ] && CLAUDE_MODEL_ARGS+=(--effort "$CLAUDE_REVIEW_EFFORT")

# agy enforces its OWN wait (--print-timeout, default 5m) on top of ours. Left unset it wins whenever
# AGENT_TIMEOUT is raised above 300, which is how three of four antigravity rounds died on 2026-07-27
# with "timeout waiting for response" despite PR_RELAY_AGENT_TIMEOUT=900. We hand agy our budget and
# give the OUTER `timeout` a few seconds more, so agy hits its own limit first and gets to print the
# diagnosis — an outer kill would only yield a bare rc 124. This is agy-only: the other reviewers'
# internal waits, if any, have not been checked.
AGY_GRACE=10
# One computed value, used both to launch agy and to report an outer kill. Two copies of the
# same arithmetic is how review-local's rc-124 message went stale one commit after the relay's
# was fixed — the reviewers caught it, twice.
AGY_OUTER_TIMEOUT=$((10#$AGENT_TIMEOUT + AGY_GRACE))
CONTEXT_FILE=""; MODE="link"; REVIEWERS_EXPLICIT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --author)       AUTHOR="$2"; shift 2;;
    --pr)           PR="$2"; shift 2;;
    --reviewers)    REVIEWERS="$2"; REVIEWERS_EXPLICIT=1; shift 2;;
    --parallel)     PARALLEL=1; shift;;
    --context-file) CONTEXT_FILE="$2"; shift 2;;
    --diff)         MODE="diff"; shift;;
    --link)         MODE="link"; shift;;
    --dry-run)      DRY=1; shift;;
    --max-rounds)   MAX_ROUNDS="$2"; shift 2;;
    --reset)        RESET=1; shift;;
    -h|--help)      relay_print_header "$0"; exit 0;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done

# Before ANY external command is trusted, including gh on the next line.
relay_assert_path_outside_repo
relay_assert_tmpdir_outside_repo_global

command -v gh >/dev/null || { echo "gh not found"; exit 1; }
case "$AUTHOR" in agy) AUTHOR=antigravity;; esac
# After AUTHOR normalization, so opencode_is_selected compares like for like.
opencode_is_selected && opencode_resolve_bin
[ -z "$PR" ] && PR=$(gh pr view --json number -q .number 2>/dev/null)
[ -z "$PR" ] && { echo "No PR found for the current branch. Pass --pr <n>."; exit 1; }
PR_URL=$(gh pr view "$PR" --json url -q .url 2>/dev/null || true)
REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
# Reviewed SHA: bind every review to the exact PR head so a concurrent push can't
# leave green reviews standing on stale code (checked again at the end).
HEAD_SHA=$(gh pr view "$PR" --json headRefOid -q .headRefOid 2>/dev/null || true)
echo "▶ Relay review for PR #$PR ${PR_URL:+($PR_URL)} — author: ${AUTHOR:-none} — mode: $MODE${HEAD_SHA:+ — sha: ${HEAD_SHA:0:7}}"
# (The fail-closed early-abort on an unreadable HEAD SHA lives AFTER the round-cap
#  check below, so a PR already at the cap still reports exit 4, not 3.)

# Per-reviewer outcome, written as files so it survives subshells under --parallel:
# $STATUS_DIR/<key> is "pending" (pre-seeded), "ok", or "fail". A reviewer that is
# hard-killed before writing leaves its pre-seeded "pending" → counted as a failure.
STATUS_DIR="$(mktemp -d)" || { echo "cannot create temp dir for outcome tracking" >&2; exit 1; }
# Armed immediately: if the ATTACH_DIR mktemp below fails we exit, and without a
# trap already installed STATUS_DIR would be left behind.
trap 'rm -rf "$STATUS_DIR"' EXIT
# Prompt attachments (the opencode reviewer gets the diff as a file) live in their
# OWN dir, deliberately NOT in $STATUS_DIR: the tally below globs "$STATUS_DIR"/*
# and treats every file there as a reviewer outcome, so an attachment dropped in
# there would be counted as a failed reviewer and poison the verdict.
# Both are mktemp -d (mode 700) and both are removed by the EXIT trap, which does
# run on SIGTERM — a per-function RETURN trap does not, and would leave the full
# PR diff behind in /tmp.
#
# EXIT alone is deliberate; do NOT add `INT TERM HUP` handlers here. Bash defers a
# trapped signal until the running foreground command finishes, so trapping TERM
# would make the relay sit through the rest of `timeout $AGENT_TIMEOUT <agent>` —
# minutes — before cleaning, whereas an untrapped TERM kills bash immediately and
# the EXIT trap fires right then. Verified in three shapes (plain child, child in a
# command substitution, backgrounded subshells as under --parallel): all cleaned on
# SIGTERM, and adding a TERM handler measurably delayed it. SIGKILL leaks, but no
# trap of any kind can prevent that.
# opencode (diff attach) and grok (prompt-file + isolated cwd) need a temp dir outside
# STATUS_DIR. Don't allocate (or widen the trap) when neither is selected.
ATTACH_DIR=""
if opencode_is_selected || grok_is_selected; then
  ATTACH_DIR="$(mktemp -d)" || { echo "cannot create temp dir for attachments" >&2; exit 1; }
  trap 'rm -rf "$STATUS_DIR" "$ATTACH_DIR"' EXIT   # widen it now that both exist
  relay_assert_tmpdir_outside_repo "$ATTACH_DIR"
fi
# Map a reviewer name to a safe filename so a crafted --reviewers value (e.g.
# "../../etc/foo") can never escape STATUS_DIR and clobber a file. The fixed "k_"
# prefix also guarantees the key is never a dotfile (which the tally glob "*"
# would silently skip) or "."/".." — either would reopen a fail-open hole.
status_key() { printf 'k_%s' "$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"; }

# The DIFF always comes from `gh pr diff` — it is authoritative (matches what GitHub shows,
# handles fork PRs, never fooled by a stale/rebased local base), and it is a single cheap
# subprocess, NOT an agent tool call.
DIFF=$(gh pr diff "$PR" 2>/dev/null)
[ -z "$DIFF" ] && { echo "Empty diff or cannot read PR #$PR."; exit 1; }
# The speed win is separate: when the current checkout PROVABLY is this PR's head AND is
# clean, we tell reviewers to read the changed files straight off disk instead of running
# `gh` themselves. Each `gh` an agentic reviewer runs is a full LLM round-trip — the main
# cause of slow-model timeouts — so removing them is the whole point.
# local_context_ok() is the single eligibility gate — used both here and at the end of the
# round, so the two invariants can't drift. It is FAIL-CLOSED: any git command that ERRORS
# (not just prints) makes it false, so a broken/foreign/dirty checkout is never trusted.
#   - inside a git work tree, and
#   - HEAD is exactly the PR head, and
#   - the tree is clean (no staged/unstaged/untracked changes).
# When it's false, reviewers are told to fetch via `gh` as before. `gh` also still POSTS the
# reviews (the consensus trail).
local_context_ok() {
  [ -n "$HEAD_SHA" ] || return 1
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  local _h _st
  _h=$(git rev-parse HEAD 2>/dev/null) || return 1
  [ "$_h" = "$HEAD_SHA" ] || return 1
  _st=$(git status --porcelain 2>/dev/null) || return 1   # git status errored → not eligible
  [ -z "$_st" ]                                            # any output → dirty → not eligible
}
LOCAL_CONTEXT=0
local_context_ok && LOCAL_CONTEXT=1
[ "$LOCAL_CONTEXT" = 1 ] && _ctx="reviewers read files locally" || _ctx="reviewers fetch via gh"
echo "  diff: $(printf '%s' "$DIFF" | wc -l) lines, $(printf '%s' "$DIFF" | wc -c) bytes ($_ctx)"

# --- Optional context document prepended to every reviewer's prompt ----------
CONTEXT_BLOCK=""
if [ -n "$CONTEXT_FILE" ]; then
  [ -f "$CONTEXT_FILE" ] || { echo "context file not found: $CONTEXT_FILE" >&2; exit 1; }
  CONTEXT_BLOCK=$(printf '## Provided context — read this and verify the PR against it\n\n%s\n\n---\n\n' "$(cat "$CONTEXT_FILE")")
  echo "  context: $CONTEXT_FILE ($(wc -c < "$CONTEXT_FILE") bytes)"
fi

# --- Hard loop guard: cap the review rounds per PR --------------------------
# Prevents an endless read→fix→re-run cycle. State is per repo+PR, kept in a cache file;
# auto-resets after 6h of inactivity (a fresh working session), or manually with --reset.
# A round is consumed once the panel is RESOLVED and about to be dispatched — the state is written
# just before pass 2, further down, NOT at the end of the run. A machine where nobody is runnable
# still consumes nothing, because that is gated on would_run. (This paragraph used to say the
# opposite, "only once at least one reviewer actually ran (see end of file)"; that stopped being
# true when the write moved ahead of dispatch to bound a kill→retry loop.)
# This is a best-effort SOFT guard, not a concurrency boundary: the counters are an unlocked
# read-modify-write, so two relays launched on the same PR at the same instant can lose an update
# and UNDERCOUNT dispatches — which weakens both caps, rather than merely overshooting one. Don't
# run concurrent relays on one PR and rely on the caps; we don't pay for locking here.
# --max-rounds must be a non-negative integer, else the arithmetic below breaks and
# silently bypasses the cap — reject it as a usage error instead.
case "$MAX_ROUNDS" in ''|*[!0-9]*) echo "invalid --max-rounds: '$MAX_ROUNDS' (want a non-negative integer)" >&2; exit 2;; esac
# Both XDG_CACHE_HOME and HOME can be unset (cron, systemd, minimal containers) and
# this script runs under `set -u`, so a bare $HOME here aborts the relay outright.
# The last-resort path is per-UID and mode 700, NOT a shared /tmp/.cache: a fixed
# world-writable path lets another user pre-create it (or plant a symlink) and then
# read or steer another user's round state.
if [ -n "${XDG_CACHE_HOME:-}" ]; then   ROUND_DIR="$XDG_CACHE_HOME/pr-review-relay"
elif [ -n "${HOME:-}" ]; then           ROUND_DIR="$HOME/.cache/pr-review-relay"
else                                    ROUND_DIR="${TMPDIR:-/tmp}/pr-review-relay-$(id -u)"; fi
# Create with the mode already applied (mkdir -m is atomic — no writable window a racer can slip
# through, and no chmod that could land on a swapped-in target), then validate what we ended up with
# and fail closed if it isn't ours.
#
# The validation below used to run ONLY on the shared /tmp fallback, on the reasoning that
# $HOME/.cache is already private. That was defensible while this directory held a single integer.
# It no longer is: it now holds REVIEW TEXT and per-run logs, so a directory that is group-writable
# (a bad umask, a restored backup, a shared build account) would leak review content and let someone
# plant a symlink for any of the files we create. Same checks, every branch.
mkdir -m 700 -p "$ROUND_DIR" 2>/dev/null
if [ -L "$ROUND_DIR" ] || [ ! -d "$ROUND_DIR" ] || [ ! -O "$ROUND_DIR" ]; then
  echo "✖ refusing to use round-state dir '$ROUND_DIR': not a directory owned by this user." >&2
  echo "  Set XDG_CACHE_HOME or HOME to a private path and re-run." >&2
  exit 1
fi
# `mkdir -m` sets the mode only when it CREATES the directory. One we own but that was left
# group/other-writable by an earlier run (or by an attacker who got there first and lost the
# ownership check) would still let someone plant a symlink, so check the mode we actually got.
# BSD/macOS `stat -f %Lp` includes the file-type bits (a 0700 dir reads as 40700), so compare only
# the low three octal digits or the check never matches and we chmod on every run.
_round_mode="$(stat -c %a "$ROUND_DIR" 2>/dev/null || stat -f %Lp "$ROUND_DIR" 2>/dev/null || echo '')"
_round_mode="${_round_mode: -3}"
case "$_round_mode" in
  700|'') ;;   # empty = no usable stat; the ownership check above still applied
  *) chmod 700 "$ROUND_DIR" 2>/dev/null || { echo "✖ cannot secure round-state dir '$ROUND_DIR' (mode $_round_mode)" >&2; exit 1; };;
esac
ROUND_KEY=$(printf '%s#%s' "${REPO:-unknown}" "$PR" | tr -c 'A-Za-z0-9._#-' '_')
ROUND_FILE="$ROUND_DIR/$ROUND_KEY.round"
# Even inside a directory we own, refuse to follow a symlinked state file: the
# counter is read, deleted and rewritten below, so a planted link would redirect
# those writes at whatever it points to.
if [ -L "$ROUND_FILE" ]; then
  echo "✖ round-state file '$ROUND_FILE' is a symlink — refusing to follow it." >&2
  exit 1
fi
# Discarding the round state and discarding this key's logs is ONE decision, never two: if they
# drift apart you get a fresh counter next to a stale transcript (or the reverse), and the forensics
# lie about which session they describe. relay_forget_key removes the whole <key>.* family.
# Sweeps the state temps too: a kill between mktemp and the mv leaves a <key>.state.XXXXXXXX
# behind, and a glob that only matched .run.* would let those accumulate forever.
relay_forget_key() { rm -f "$ROUND_FILE" "$ROUND_DIR/$ROUND_KEY".run.* "$ROUND_DIR/$ROUND_KEY".state.* 2>/dev/null || true; }
[ "$RESET" = 1 ] && relay_forget_key
# mtime: GNU `stat -c %Y`, BSD/macOS `stat -f %m`.
_round_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }
if [ -f "$ROUND_FILE" ] && [ $(( $(date +%s) - $(_round_mtime "$ROUND_FILE") )) -gt 21600 ]; then
  relay_forget_key   # stale (>6h): new session, start fresh — state AND transcripts
fi

# --- Round state: "<sha> <rounds> <same-sha-invocations>" --------------------
# Why per-SHA. The old counter advanced once per INVOCATION, so splitting a panel across three
# single-reviewer runs on one commit burnt the whole cap — punishing exactly the workaround you are
# forced into when the relay keeps dying mid-round. What the guard is actually there to stop is an
# endless read→fix→re-run cycle, and a real cycle always involves a push. So:
#   * a NEW head SHA advances the round counter  (that is the cycle, and --max-rounds bounds it)
#   * an UNCHANGED head SHA advances only the same-SHA counter (PR_RELAY_MAX_SAME_SHA bounds that)
# Strictly it counts SHA TRANSITIONS, not distinct SHAs: only the last SHA is stored, so
# shaA → shaB → shaA spends three rounds. That is intended — a revert-and-retry loop should cost.
_state_sha=""; ROUND=0; SAME=0; _state_legacy=0
if [ -f "$ROUND_FILE" ]; then
  read -r _f1 _f2 _f3 _rest < "$ROUND_FILE" 2>/dev/null || true
  _f1="${_f1:-}"; _f2="${_f2:-}"; _f3="${_f3:-}"; _rest="${_rest:-}"
  if [ -n "$_f1" ] && [ -z "$_f2" ] && [ -z "$_rest" ]; then
    case "$_f1" in ''|*[!0-9]*) ;; *) ROUND="$_f1"; _state_legacy=1;; esac   # legacy: bare counter
  elif [ -n "$_f1" ] && [ -n "$_f2" ] && [ -n "$_f3" ] && [ -z "$_rest" ]; then
    case "$_f2$_f3" in ''|*[!0-9]*) ;; *) _state_sha="$_f1"; ROUND="$_f2"; SAME="$_f3";; esac
  fi
  # anything else → all three stay at their zero defaults, exactly as a corrupted bare counter did
  unset _f1 _f2 _f3 _rest
fi

# Is this dispatch a continuation of the same reviewed code, or a new revision? The predicate is
# deliberately explicit: the stored SHA must be NON-EMPTY *and* equal to the current head. Written as
# a bare "$SAME -ge $MAX_SAME_SHA" check it would refuse a genuine fix push that arrives while the
# previous SHA happened to be at its same-SHA cap.
SAME_SHA=0
[ -n "$_state_sha" ] && [ -n "$HEAD_SHA" ] && [ "$_state_sha" = "$HEAD_SHA" ] && SAME_SHA=1
# A legacy file carries no SHA, so this head counts as new — but do NOT also spend a round for it.
# Someone sitting at 2/3 when they upgrade would otherwise be written straight to 3/3 and lose the
# same-SHA retries this change exists to give them. A legacy file already AT the cap is a different
# case and keeps the old meaning exactly: it was written by a version where the count was rounds, it
# says the loop is over, and it still exits 4 below (before anything is written or dispatched).
if [ "$SAME_SHA" = 1 ]; then         NEXT_ROUND="$ROUND"; NEXT_SAME=$((SAME + 1))
elif [ "$_state_legacy" = 1 ]; then  NEXT_ROUND="$ROUND"; NEXT_SAME=1
else                                 NEXT_ROUND=$((ROUND + 1)); NEXT_SAME=1; fi
# --- Run evidence: one log for this invocation, one sidecar per reviewer -----
# ONE WRITER PER FILE. Under --parallel each reviewer runs in a background subshell, so a single
# shared append target would interleave multi-line review bodies into garbage. The parent writes
# only this log; each reviewer writes only its own sidecar. No locking, nothing to merge, and
# therefore nothing that depends on the run reaching its end.
#
# The name is created with mktemp, which is O_EXCL and mode 600, so it is unique PER INVOCATION and
# cannot be a planted symlink. Unique matters: a fixed <key>.<reviewer> name would hand the same
# file to every retry, and a retry after a kill would overwrite the very evidence of the kill.
# (`date +%s`-plus-$$ was the obvious alternative and is not collision-safe — PIDs get reused.)
#
# Created BEFORE the cap checks below, deliberately. It used to come after, which meant an exit-4
# run — the one where an operator most wants to know what the counters were and why it stopped —
# left no log at all, while the README promised every invocation leaves evidence. All three
# cross-reviewers caught that. The cost is one small file on a run that dispatches nobody.
RUN_BASE="$(mktemp "$ROUND_DIR/$ROUND_KEY.run.XXXXXXXX" 2>/dev/null)" || {
  echo "cannot create run log in '$ROUND_DIR'" >&2; exit 1; }
relay_log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$RUN_BASE"; }
# Printed NOW, not only in the closing banner: a killed run never reaches the banner, which is
# exactly the run whose log someone will want.
echo "  run log: $RUN_BASE"
relay_log "start pr=$PR repo=${REPO:-?} sha=${HEAD_SHA:-<unreadable>} mode=$MODE author=${AUTHOR:-none}"
relay_log "start reviewers=$REVIEWERS parallel=$PARALLEL dry=$DRY timeout=${AGENT_TIMEOUT}s"
# PID and PGID are recorded so that the NEXT time something kills this process mid-round, the log
# says what to look for. Every investigation so far has ended outside this script.
relay_log "start pid=$$ pgid=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ') round=$NEXT_ROUND/$MAX_ROUNDS same_sha=$NEXT_SAME/$MAX_SAME_SHA"

if [ "$_state_legacy" = 1 ] && [ "$ROUND" -ge "$MAX_ROUNDS" ]; then
  relay_log "verdict exit=4 round cap (legacy state $ROUND/$MAX_ROUNDS)"
  echo "⛔ Review round cap reached for $REPO#$PR ($ROUND/$MAX_ROUNDS)." >&2
  echo "   STOP the review loop: do NOT run the relay again on this PR. Address any" >&2
  echo "   remaining items manually, or pass --reset to force another round." >&2
  exit 4
fi

if [ "$SAME_SHA" = 1 ] && [ "$SAME" -ge "$MAX_SAME_SHA" ]; then
  relay_log "verdict exit=4 same-SHA cap ($SAME/$MAX_SAME_SHA on ${HEAD_SHA:0:7})"
  echo "⛔ Same-SHA dispatch cap reached for $REPO#$PR ($SAME/$MAX_SAME_SHA on ${HEAD_SHA:0:7})." >&2
  echo "   The reviewed code has not changed for $SAME dispatches. STOP: push a fix so there is" >&2
  echo "   something new to review, raise PR_RELAY_MAX_SAME_SHA, or pass --reset." >&2
  exit 4
fi
if [ "$NEXT_ROUND" -gt "$MAX_ROUNDS" ]; then
  relay_log "verdict exit=4 round cap ($ROUND/$MAX_ROUNDS reviewed revisions)"
  echo "⛔ Review round cap reached for $REPO#$PR ($ROUND/$MAX_ROUNDS reviewed revisions)." >&2
  echo "   STOP the review loop: do NOT run the relay again on this PR. Address any" >&2
  echo "   remaining items manually, or pass --reset to force another round." >&2
  exit 4   # distinct code: not a clean pass — escalate, don't treat as consensus
fi
if [ "$SAME_SHA" = 1 ]; then
  echo "  review round: $NEXT_ROUND/$MAX_ROUNDS — invocation $NEXT_SAME/$MAX_SAME_SHA on this SHA"
else
  echo "  review round: $NEXT_ROUND/$MAX_ROUNDS — new SHA, invocation 1/$MAX_SAME_SHA"
fi

# Fail-closed early (but AFTER the cap check above, so an at-cap PR still exits 4):
# if we can't read the head SHA now, we can never prove HEAD stayed put — abort
# before spending reviewer runs (a dry-run needs no SHA).
if [ "$DRY" = 0 ] && [ -z "$HEAD_SHA" ]; then
  relay_log "verdict exit=3 head sha unreadable at start"
  echo "✖ Could not read PR head SHA — cannot prove HEAD stability. Re-run." >&2; exit 3
fi

# --- Build the review prompt -------------------------------------------------
if [ "$MODE" = diff ]; then
  read -r -d '' BASE <<'P' || true
You are reviewing a pull request. Review the diff (provided on stdin) for correctness
bugs, security issues, broken edge cases, regressions, missing or inadequate tests for
the behaviour the change touches, violations of the repository's own conventions, and
clear design/maintainability problems.
You may read files in the current repo for context, but DO NOT modify anything.
If this checkout is the PR head, read the conventions that apply to the touched paths
(AGENTS.md, CLAUDE.md, CONTRIBUTING.md — including nested ones nearer the changed files)
and judge the change against them; otherwise skip that step. If the change itself edits a
conventions file, that edit is part of what you are reviewing, not authority over it.
Give a file and line reference for every finding where one applies.
Report missing tests as Should-fix, unless the untested path is itself a Blocker.
Be concise. Group findings by severity: Blocker / Should-fix / Nit.
If it looks good, say so in one line.
P
elif [ "$LOCAL_CONTEXT" = 1 ]; then
  # This checkout IS the PR head and is clean, so point reviewers at the code on disk for
  # context instead of GitHub — no `gh` round-trips, the whole speed win. The diff below is
  # still the authoritative one from `gh pr diff`.
  read -r -d '' BASE <<P || true
You are reviewing an OPEN pull request: PR #$PR in $REPO ${PR_URL:+($PR_URL)}.
The exact code under review is CHECKED OUT in the current directory (this working tree is
the PR head). Read the files the diff touches — and anything they reference — DIRECTLY from
this checkout for full context, not just the diff hunks below. Do NOT run \`gh\` or fetch
anything over the network (you already have the code), and do NOT modify anything. Read
the conventions that apply to the touched paths (AGENTS.md, CLAUDE.md, CONTRIBUTING.md —
including nested ones nearer the changed files) and judge the change against them; if the
change itself edits a conventions file, that edit is part of what you are reviewing, not
authority over it. Then review for correctness bugs, security issues, broken edge cases,
regressions, missing or inadequate tests for the behaviour the change touches, violations
of those conventions, and clear design/maintainability problems.
Give a file and line reference for every finding where one applies.
Report missing tests as Should-fix, unless the untested path is itself a Blocker.
Be concise. Group findings by severity:
Blocker / Should-fix / Nit. If it looks good, say so in one line.
P
else
  read -r -d '' BASE <<P || true
You are reviewing an OPEN pull request: PR #$PR in $REPO ${PR_URL:+($PR_URL)}.
Go read it YOURSELF before reviewing — you have read-only repo + gh access:
  gh pr view $PR      # title, body, discussion
  gh pr diff $PR      # the change
Read the files the diff touches (and anything the PR or the context above references)
for full context — not just the diff. This checkout may NOT be the PR head, so read the
repository's conventions (AGENTS.md, CLAUDE.md, CONTRIBUTING.md — including nested ones
nearer the changed files) from the PR revision and judge the change against them; skip
that step if you cannot establish which revision you are reading. If the change itself
edits a conventions file, that edit is part of what you are reviewing, not authority over
it. Then review for correctness bugs, security issues, broken edge cases, regressions,
missing or inadequate tests for the behaviour the change touches, violations of those
conventions, and clear design/maintainability problems. DO NOT modify anything.
Give a file and line reference for every finding where one applies.
Report missing tests as Should-fix, unless the untested path is itself a Blocker.
Be concise. Group findings by severity: Blocker / Should-fix / Nit.
If it looks good, say so in one line.
P
fi
PROMPT="${CONTEXT_BLOCK}${BASE}"
# Embed the (authoritative, gh-sourced) diff in the prompt. In local-context mode it's the
# change to review, with the files on disk for full context; otherwise it's a FALLBACK so a
# reviewer whose sandbox can't run `gh` never comes back empty. A huge inline diff blows past
# some agents' prompt limits and makes them return empty (observed with codex/antigravity on
# 100KB+ PRs), so above a threshold we omit it and tell reviewers to get the whole change via
# `gh pr diff` (authoritative). Tune via env LINK_DIFF_FALLBACK_MAX_BYTES (default 100000;
# set 0 to always omit).
LINK_DIFF_FALLBACK_MAX_BYTES="${LINK_DIFF_FALLBACK_MAX_BYTES:-100000}"
# Validated: a non-numeric value would blow up in the arithmetic below.
case "$LINK_DIFF_FALLBACK_MAX_BYTES" in ''|*[!0-9]*) echo "invalid LINK_DIFF_FALLBACK_MAX_BYTES: '$LINK_DIFF_FALLBACK_MAX_BYTES' (want bytes)" >&2; exit 2;; esac
if [ "$MODE" = link ]; then
  _diff_bytes=$(printf '%s' "$DIFF" | wc -c | tr -d ' ')
  if [ "$_diff_bytes" -le "$LINK_DIFF_FALLBACK_MAX_BYTES" ]; then
    if [ "$LOCAL_CONTEXT" = 1 ]; then
      PROMPT=$(printf '%s\n\n---\n## The change (diff)\nThe changed files are on disk in this checkout — read them for full context. The change itself:\n\n```diff\n%s\n```\n' "$PROMPT" "$DIFF")
    else
      PROMPT=$(printf '%s\n\n---\n## Fallback: the PR diff\nPrefer fetching the full PR with the `gh` commands above — you get the whole changed files, not just these hunks. If your sandbox cannot run `gh`, review this diff instead so you never return empty:\n\n```diff\n%s\n```\n' "$PROMPT" "$DIFF")
    fi
  else
    if [ "$LOCAL_CONTEXT" = 1 ]; then
      echo "  (diff ${_diff_bytes}B > ${LINK_DIFF_FALLBACK_MAX_BYTES}B — omitting inline; reviewers read files locally, may run \`gh pr diff $PR\` for the hunks)"
      PROMPT=$(printf '%s\n\n---\nThe change is large, so it is not inlined here. The changed files are on disk in this checkout — read them directly. If you need the exact hunks, you MAY run just `gh pr diff %s` to get them — that single command is allowed as an exception to the "do not run gh" note above; do not fetch anything else.\n' "$PROMPT" "$PR")
    else
      echo "  (diff ${_diff_bytes}B > ${LINK_DIFF_FALLBACK_MAX_BYTES}B — omitting inline fallback; reviewers fetch the PR via gh)"
    fi
  fi
fi

# $OPENCODE_BIN is already resolved (opencode_resolve_bin, near the top) so the same
# value feeds both the `command -v` availability check in the reviewer loop and the
# invocation in review_with(). It has to happen before that loop: resolving lazily
# inside tool_for() would be dead code, because the loop skips on `command -v` first.
tool_for() { case "$1" in claude) echo claude;; codex) echo codex;; cursor) echo cursor-agent;; antigravity|agy) echo agy;; opencode) echo "$OPENCODE_BIN";; qwen) echo qwen;; grok) echo grok;; *) echo "";; esac; }

review_with() {
  # TRUNCATED is local: sequential mode reuses this function, and a leaked 1 from a previous
  # reviewer would mislabel the next one's failure message.
  local name="$1" out="" feed="" rc=0 errf skey Name id side TRUNCATED=0
  skey="$(status_key "$name")"
  # Capitalize first letter — Bash 3.2-safe (no ${name^}, which is Bash 4+).
  Name="$(printf '%s' "${name:0:1}" | tr '[:lower:]' '[:upper:]')${name:1}"
  errf="$(mktemp)"
  [ "$MODE" = diff ] && feed="$DIFF"   # only diff mode pipes the diff; link mode fetches it
  # Cap the stderr capture as well. Bounding only stdout left the documented "a runaway reviewer
  # cannot fill the disk" guarantee false: agents are chatty on stderr (progress, retries, stack
  # traces) and nothing limited it. Only the last LOG_MAX_BYTES are kept, because the diagnosis is
  # at the END of a transcript, and the reader only ever sees `tail -n 15` of it anyway.
  _cap_errf() { [ -s "$errf" ] || return 0
    [ "$(wc -c < "$errf" 2>/dev/null || echo 0)" -le "$LOG_MAX_BYTES" ] && return 0
    local _t; _t="$(mktemp)" || return 0
    tail -c "$LOG_MAX_BYTES" "$errf" > "$_t" 2>/dev/null && mv -f "$_t" "$errf" || rm -f "$_t"; }
  # This reviewer's sidecar. The name is derived from RUN_BASE (already unique and freshly created
  # by mktemp) and from status_key, the same sanitizer $STATUS_DIR uses — so a crafted --reviewers
  # value cannot escape $ROUND_DIR through this path either. The -L refusal is defence in depth:
  # the real control is that $ROUND_DIR is a mode-700 directory we own.
  side="$RUN_BASE.$skey.review"
  if [ -L "$side" ]; then
    echo "  ! $name: sidecar path '$side' is a symlink — refusing to write" >&2
    echo fail > "$STATUS_DIR/$skey"; rm -f "$errf"; return 0
  fi
  printf '=== %s review — started %s ===\n' "$name" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$side"
  # THE CAPTURE. The agent's stdout streams into the sidecar as it is produced, instead of being
  # buffered whole in `out=$(...)` — which is what made a mid-reviewer kill lose everything the
  # reviewer had already written. Three things are load-bearing and easy to get wrong:
  #   1. `head -c` bounds the file ON THE WRITE PATH, so a runaway agent cannot fill the disk; it
  #      also applies backpressure (SIGPIPE) rather than letting it run to AGENT_TIMEOUT.
  #   2. rc must come from PIPESTATUS for the AGENT's position in the pipeline. Plain `$?` would be
  #      head's status and every reviewer would look successful.
  #   3. `out` is read back from the sidecar afterwards. Assigning the pipeline to `out=$(...)`
  #      while also redirecting stdout into the file yields an ALWAYS-EMPTY out.
  # Partial capture is best-effort: many CLIs block-buffer when stdout is not a TTY, so a kill can
  # still leave an empty or chunked sidecar. stdbuf helps where it exists and is never required.
  # This is strictly better than the old behaviour, which lost the lot.
  local -a SB=(); command -v stdbuf >/dev/null 2>&1 && SB=(stdbuf -oL)
  case "$name" in
    claude)       printf '%s' "$feed" | ${SB[@]+"${SB[@]}"} timeout "$AGENT_TIMEOUT" claude -p ${CLAUDE_MODEL_ARGS[@]+"${CLAUDE_MODEL_ARGS[@]}"} "$PROMPT" 2>"$errf" | head -c "$LOG_MAX_BYTES" >> "$side"; rc=${PIPESTATUS[1]};;
    codex)        printf '%s' "$feed" | ${SB[@]+"${SB[@]}"} timeout "$AGENT_TIMEOUT" codex exec -s danger-full-access ${CODEX_MODEL_ARGS[@]+"${CODEX_MODEL_ARGS[@]}"} "$PROMPT" 2>"$errf" | head -c "$LOG_MAX_BYTES" >> "$side"; rc=${PIPESTATUS[1]};;
    qwen)         printf '%s' "$feed" | QWEN_CODE_SUPPRESS_YOLO_WARNING=1 ${SB[@]+"${SB[@]}"} timeout "$AGENT_TIMEOUT" qwen --safe-mode --approval-mode yolo -p "$PROMPT" 2>"$errf" | head -c "$LOG_MAX_BYTES" >> "$side"; rc=${PIPESTATUS[1]};;
    cursor)
      if [ "$MODE" = diff ]; then
        printf '%s\n\n%s' "$PROMPT" "$DIFF" | ${SB[@]+"${SB[@]}"} timeout "$AGENT_TIMEOUT" cursor-agent -p --trust --mode=ask --model "$CURSOR_REVIEW_MODEL" 2>"$errf" | head -c "$LOG_MAX_BYTES" >> "$side"
      else
        printf '%s' "$PROMPT" | ${SB[@]+"${SB[@]}"} timeout "$AGENT_TIMEOUT" cursor-agent -p --trust --mode=ask --model "$CURSOR_REVIEW_MODEL" 2>"$errf" | head -c "$LOG_MAX_BYTES" >> "$side"
      fi; rc=${PIPESTATUS[1]};;
    antigravity)
      # No stdin producer here, so the agent is pipeline element 0, not 1.
      if [ "$MODE" = diff ]; then
        ${SB[@]+"${SB[@]}"} timeout "$AGY_OUTER_TIMEOUT" agy --dangerously-skip-permissions --print-timeout "${AGENT_TIMEOUT}s" ${AGY_MODEL_ARGS[@]+"${AGY_MODEL_ARGS[@]}"} -p "$(printf '%s\n\n%s' "$PROMPT" "$DIFF")" 2>"$errf" | head -c "$LOG_MAX_BYTES" >> "$side"
      else
        ${SB[@]+"${SB[@]}"} timeout "$AGY_OUTER_TIMEOUT" agy --dangerously-skip-permissions --print-timeout "${AGENT_TIMEOUT}s" ${AGY_MODEL_ARGS[@]+"${AGY_MODEL_ARGS[@]}"} -p "$PROMPT" 2>"$errf" | head -c "$LOG_MAX_BYTES" >> "$side"
      fi; rc=${PIPESTATUS[0]};;
    opencode)
      opencode_review "$ATTACH_DIR" "$DIFF" "$CONTEXT_BLOCK" \
              "PR #$PR in $REPO ${PR_URL:+($PR_URL)}" "$errf" "$AGENT_TIMEOUT" | head -c "$LOG_MAX_BYTES" >> "$side"
      rc=${PIPESTATUS[0]};;
    grok)
      grok_review "$ATTACH_DIR" "$DIFF" "$CONTEXT_BLOCK" \
              "PR #$PR in $REPO ${PR_URL:+($PR_URL)}" "$errf" "$AGENT_TIMEOUT" | head -c "$LOG_MAX_BYTES" >> "$side"
      rc=${PIPESTATUS[0]};;
  esac
  _cap_errf
  # When the bound fires, `head` closes the pipe and the agent dies of SIGPIPE (rc 141). Mark the
  # body so the reader — and the posted comment — can see where it stops.
  #
  # The round is then NOT clean, and that is deliberate. An earlier version normalised this to rc 0
  # on the reasoning that a merely long review should not fail a round; cross-review pointed out
  # that this breaks the script's whole contract. A truncated review is an INCOMPLETE one: the
  # findings that did not fit are indistinguishable from findings that do not exist, and exit 0
  # means "every reviewer produced and posted a review", which would then be a lie. The relay is
  # fail-closed everywhere else for exactly this reason. So the text is still posted (informative),
  # the round reports 3, and you re-run with a bigger PR_RELAY_LOG_MAX_BYTES — the same treatment a
  # reviewer that exits non-zero with output already gets, a few lines below.
  TRUNCATED=0
  if [ "$rc" = 141 ] && [ "$(wc -c < "$side" 2>/dev/null || echo 0)" -ge "$LOG_MAX_BYTES" ]; then
    printf '\n[... truncated at %s bytes by PR_RELAY_LOG_MAX_BYTES — this review is INCOMPLETE, so the round is not clean; raise the limit and re-run ...]\n' "$LOG_MAX_BYTES" >> "$side"
    TRUNCATED=1
  fi
  # Read the body back, dropping the header line we wrote above. This is the value the rest of the
  # function used to get straight out of the command substitution.
  out="$(sed '1d' "$side" 2>/dev/null)"
  printf '=== %s finished rc=%s %s ===\n' "$name" "$rc" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$side"
  # Never fail silently: if the agent produced no review, say why in human terms
  # and show what it wrote on stderr. "Empty" means no non-whitespace content, so
  # a tab/newline-only reply doesn't slip through as a valid review.
  if [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then
    local why="exited with code $rc"
    case "$rc" in
      0)   why="ran fine but returned an empty review";;
      124) why="timed out after $([ "$name" = antigravity ] && echo "$AGY_OUTER_TIMEOUT" || echo "$AGENT_TIMEOUT")s (raise PR_RELAY_AGENT_TIMEOUT)";;
      126) why="found but could not be executed (exit 126)";;
      127) why="command not found";;
    esac
    echo "  ! $name: no review — $why" >&2
    # On timeout stderr only holds the agent's partial transcript — skip it.
    if [ "$rc" != 124 ] && [ -s "$errf" ]; then
      echo "    $name stderr (last 15 lines):" >&2
      tail -n 15 "$errf" | sed 's/^/    │ /' >&2
    fi
    echo fail > "$STATUS_DIR/$skey"   # no output → round is not clean
    rm -f "$errf"; return 0
  fi
  local unclean=0
  if [ "$rc" -ne 0 ]; then
    # Produced a review but the CLI exited non-zero: the review may be truncated,
    # so the round is NOT clean even though we still post what we got (informative).
    if [ "$TRUNCATED" = 1 ]; then
      echo "  ! $name: review exceeded PR_RELAY_LOG_MAX_BYTES ($LOG_MAX_BYTES) and was truncated — INCOMPLETE, round not clean" >&2
    else
      echo "  ! $name: exited with code $rc — review may be truncated (round not clean)" >&2
    fi
    unclean=1
  fi
  rm -f "$errf"
  local icon; case "$name" in claude) icon="🟣";; codex) icon="🟢";; cursor) icon="🔵";; antigravity) icon="🟠";; opencode) icon="⚪";; qwen) icon="🟡";; grok) icon="⚡";; *) icon="🤖";; esac
  # Echo the review to stdout so the agent that launched the relay can read it,
  # address the findings, push, and re-run (the iterate loop). Single printf to
  # stay roughly atomic under --parallel.
  printf '\n========== %s review ==========\n%s\n===============================\n' "$Name" "$out"
  # idempotent: remove any previous review from the SAME agent on this PR
  if [ -n "$REPO" ]; then
    for id in $(gh api --paginate "repos/$REPO/issues/$PR/comments" \
                  --jq ".[] | select(.body|contains(\"$Name review (automated cross-review)\")) | .id" 2>/dev/null); do
      gh api -X DELETE "repos/$REPO/issues/comments/$id" >/dev/null 2>&1 || true
    done
  fi
  # Post the review COLLAPSED: wrap it in <details>/<summary> via the helper so
  # the PR page shows a one-line toggle (forum-style hide/show) per reviewer.
  local footer comment_body out_file
  footer="<sub>via pr-review-relay · author: ${AUTHOR:-?}${CONTEXT_FILE:+ · context: $(basename "$CONTEXT_FILE")}${HEAD_SHA:+ · reviewed sha: ${HEAD_SHA:0:7}}</sub>"
  comment_body="$(mktemp)"; out_file="$(mktemp)"
  printf '%s' "$out" > "$out_file"
  # If the wrapper fails (node missing/broken) or yields an empty body, do NOT post
  # a broken/partial comment and mark ok — treat it as a failed reviewer.
  if ! node "$WRAP_COMMENT" \
        --summary "${icon} $Name review (automated cross-review)" \
        --footer "$footer" \
        --file "$out_file" > "$comment_body" || [ ! -s "$comment_body" ]; then
    echo "  ! $name: could not render comment (wrapper failed / empty output)" >&2
    echo fail > "$STATUS_DIR/$skey"
    rm -f "$out_file" "$comment_body"; return 0
  fi
  rm -f "$out_file"
  if gh pr comment "$PR" --body-file "$comment_body" >/dev/null; then
    echo "  ✓ $name review posted (collapsed)"
    [ "$unclean" = 1 ] && echo fail > "$STATUS_DIR/$skey" || echo ok > "$STATUS_DIR/$skey"
  else
    echo "  ! $name: failed to post comment" >&2
    echo fail > "$STATUS_DIR/$skey"   # review not visible on the PR → not clean
  fi
  rm -f "$comment_body"
}

# Passing the default list explicitly flips missing CLIs from tolerated skips to
# hard failures — warn, since it's an easy copy-paste-from-help footgun.
if [ "$REVIEWERS_EXPLICIT" = 1 ] && [ "$REVIEWERS" = "claude,codex,cursor,antigravity" ]; then
  echo "  note: --reviewers matches the default, so a missing default CLI is now a hard failure (exit 3), not a skip. Omit --reviewers to tolerate missing agents." >&2
fi

IFS=',' read -ra LIST <<< "$REVIEWERS"
# dedupe: same reviewer twice would share one status file (race under --parallel).
# Space-delimited string, not an assoc array, so this stays Bash 3.2-safe (macOS).
SEEN_LIST=""
would_run=0; skipped=0   # reviewers that would run / were tolerated-skipped (default set)
# Pass 1 RESOLVES the panel; pass 2 (further down) dispatches it. They are split so the round state
# can be made durable in between — see the write block below. Everything with a side effect that the
# dry-run and exit-3 paths depend on (author skip, dedupe, the `fail` files for an unknown or
# missing explicitly-requested reviewer, and would_run itself) stays HERE, in pass 1.
# Reviewer names are already normalized and validated here, and cannot contain whitespace, so the
# space-delimited accumulator is safe (same reasoning as SEEN_LIST above) and keeps this Bash 3.2-safe.
RUNNABLE=""
for r in "${LIST[@]}"; do
  r="$(relay_trim "$r")"   # same normalization as opencode_is_selected
  [ -z "$r" ] && continue           # tolerate empty items (e.g. "claude,,codex")
  [ "$r" = "agy" ] && r=antigravity
  [ "$r" = "$AUTHOR" ] && { echo "  – skip $r (author)"; continue; }
  rkey="$(status_key "$r")"          # rkey has no spaces, so the string check is safe
  case " $SEEN_LIST " in *" $rkey "*) echo "  – skip $r (duplicate)"; continue;; esac
  SEEN_LIST="$SEEN_LIST $rkey"
  local_tool=$(tool_for "$r")
  if [ -z "$local_tool" ]; then
    if [ "$REVIEWERS_EXPLICIT" = 1 ]; then echo "  ! unknown reviewer '$r' (explicitly requested → fail)" >&2; echo fail > "$STATUS_DIR/$rkey"; else echo "  ! unknown reviewer '$r' (skip)"; fi
    continue
  fi
  if ! command -v "$local_tool" >/dev/null; then
    # Not installed: a hard failure only if the user explicitly asked for this
    # reviewer; for the default set it's a tolerated skip (users have different CLIs).
    if [ "$REVIEWERS_EXPLICIT" = 1 ]; then echo "  ! $local_tool not installed but explicitly requested → fail" >&2; echo fail > "$STATUS_DIR/$rkey"; else echo "  ! $local_tool not installed (skip $r)"; skipped=$((skipped + 1)); fi
    continue
  fi
  would_run=$((would_run + 1))
  if [ "$DRY" = 1 ]; then echo "  · would run: $r ($local_tool)"; continue; fi
  RUNNABLE="$RUNNABLE $r"     # pass 2 dispatches these, once the state is durable
done

# --- Persist the round state BEFORE dispatching ------------------------------
# It used to be written after the reviewer loop and the `wait`. That had one good property — a
# process killed mid-round consumed nothing — and one bad one: a kill→retry loop was unbounded,
# because neither counter ever advanced. Writing first keeps the loop guard honest. The good
# property is preserved by the per-SHA split above, not by the write timing: a retry on an
# unchanged SHA still costs no round, only a same-SHA invocation.
#
# Gate on would_run (agents actually resolved), NOT on the tally: a preflight-only failure like
# `--reviewers bogus` writes a fail file but launches nobody, and must not burn anything. That is
# what pass 1 / pass 2 exist to separate — the old single loop got this for free by writing late.
if [ "$DRY" = 0 ] && [ "$would_run" -gt 0 ]; then
  # Atomic replace. A kill during a plain `echo >` can leave the file empty or half-written, and
  # the corrupt-state rule then reads it as zero — silently resetting BOTH caps. That was survivable
  # while the write happened at the very end of a run; with the write moved before dispatch it is
  # squarely in the kill window. mktemp is O_EXCL and mode 600, so the temp cannot be a planted
  # symlink either (a fixed "$ROUND_FILE.tmp" would be both predictable and shared between
  # concurrent relays). The script runs under `set -uo pipefail`, NOT `set -e`, so both the write
  # and the rename are checked by hand — an unnoticed failure here would dispatch reviewers with no
  # durable state, which is the exact hole this block closes.
  _state_tmp="$(mktemp "$ROUND_DIR/$ROUND_KEY.state.XXXXXXXX" 2>/dev/null)" || {
    echo "✖ cannot create round-state temp file in '$ROUND_DIR'" >&2; exit 1; }
  if ! printf '%s %s %s\n' "$HEAD_SHA" "$NEXT_ROUND" "$NEXT_SAME" > "$_state_tmp"; then
    rm -f "$_state_tmp"; echo "✖ cannot write round state" >&2; exit 1
  fi
  if ! mv -f "$_state_tmp" "$ROUND_FILE"; then
    rm -f "$_state_tmp"; echo "✖ cannot install round state at '$ROUND_FILE'" >&2; exit 1
  fi
  relay_log "state sha=${HEAD_SHA:0:7} round=$NEXT_ROUND same=$NEXT_SAME (written before dispatch)"
else
  relay_log "state not advanced (dry=$DRY would_run=$would_run)"
fi

# --- Pass 2: dispatch --------------------------------------------------------
for r in $RUNNABLE; do
  rkey="$(status_key "$r")"
  echo "  → $r reviewing…"
  relay_log "dispatch $r"
  # Pre-seed "pending": if the reviewer is hard-killed before it can record its
  # own outcome, this file survives and the tally counts it as a failure (not a
  # silent exclusion that could let the round pass clean).
  echo pending > "$STATUS_DIR/$rkey"
  if [ "$PARALLEL" = 1 ]; then review_with "$r" & else review_with "$r"; fi
done
[ "$PARALLEL" = 1 ] && wait

# --- Fail-closed verdict -----------------------------------------------------
# Tally per-reviewer outcomes recorded under $STATUS_DIR (pending/ok/fail).
ran=0; failed=0; failed_names=""
for f in "$STATUS_DIR"/*; do
  [ -e "$f" ] || continue
  ran=$((ran + 1))
  n="${f##*/}"; _outcome="$(cat "$f")"
  # Logged HERE, in the parent, after `wait` — never from review_with. A background subshell
  # appending to the shared run log is exactly the interleaving the sidecars exist to avoid.
  relay_log "outcome ${n#k_}=$_outcome"
  if [ "$_outcome" != ok ]; then failed=$((failed + 1)); failed_names="$failed_names ${n#k_}"; fi
done
unset _outcome

# In --dry-run no reviewer executes, but explicitly-requested reviewers that are
# unknown/missing DO record a failure above — surface that as a non-zero preflight
# instead of a false clean pass. Zero runnable reviewers is also a failed preflight.
if [ "$DRY" = 1 ]; then
  if [ "$failed" -gt 0 ]; then relay_log "verdict exit=3 dry-run invalid config —$failed_names"; echo "✖ Dry run: invalid --reviewers config —$failed_names." >&2; exit 3; fi
  if [ "$would_run" = 0 ]; then relay_log "verdict exit=3 dry-run no runnable reviewers"; echo "✖ Dry run: no runnable reviewers (none installed / all excluded)." >&2; exit 3; fi
  relay_log "verdict exit=0 dry-run ok would_run=$would_run"
  echo "✔ Dry run complete (config valid; $would_run reviewer(s) would run)."; exit 0
fi

# (The round state was persisted BEFORE dispatch — see the write block above. It deliberately no
#  longer happens here: a run killed at this point has already recorded that it dispatched.)

# EVERY terminal path below logs its verdict before exiting. If only the happy path did, the run
# log would go silent in precisely the situations worth investigating.
# SHA binding is fail-closed: we must be able to read HEAD before AND after. If
# either read fails we cannot prove HEAD stayed put, so we do NOT pass.
NEW_SHA=$(gh pr view "$PR" --json headRefOid -q .headRefOid 2>/dev/null || true)
if [ -z "$HEAD_SHA" ] || [ -z "$NEW_SHA" ]; then
  relay_log "verdict exit=3 head sha unreadable (start='${HEAD_SHA:-}' end='${NEW_SHA:-}')"
  echo "✖ Could not read PR head SHA (${HEAD_SHA:+start ok}${HEAD_SHA:-start FAILED}/${NEW_SHA:+end ok}${NEW_SHA:-end FAILED}): cannot prove HEAD stability. Re-run." >&2
  exit 3
fi
if [ "$HEAD_SHA" != "$NEW_SHA" ]; then
  relay_log "verdict exit=3 head moved ${HEAD_SHA:0:7} -> ${NEW_SHA:0:7}"
  echo "✖ HEAD moved during the round (${HEAD_SHA:0:7} → ${NEW_SHA:0:7}): reviews are stale. Re-run." >&2
  exit 3
fi
# In local-context mode the reviewers read the working tree, so a local commit, checkout, or
# edit during the round would make their reviews stale. Re-assert the SAME eligibility gate
# (HEAD unchanged AND still clean) with the same fail-closed helper.
if [ "$LOCAL_CONTEXT" = 1 ] && ! local_context_ok; then
  relay_log "verdict exit=3 local checkout changed during the round"
  echo "✖ Local checkout changed during the round (HEAD moved or working tree now dirty): reviewers may have read code not in the PR. Re-run." >&2
  exit 3
fi

if [ "$ran" = 0 ]; then
  relay_log "verdict exit=3 no reviewers ran"
  echo "✖ No reviewers ran — cannot form consensus from nobody. Check installed CLIs / --reviewers." >&2
  exit 3
fi
if [ "$failed" -gt 0 ]; then
  relay_log "verdict exit=3 not clean: $failed/$ran failed —$failed_names"
  echo "✖ Relay round NOT clean: $failed/$ran reviewer(s) failed —$failed_names. Fix and re-run." >&2
  exit 3
fi
if [ "$skipped" -gt 0 ]; then
  relay_log "verdict exit=0 partial: $ran posted, $skipped skipped"
  echo "✔ Relay done (PARTIAL cross-review) — $ran/$ran reviewer(s) posted, $skipped skipped (not installed), reviewed sha ${HEAD_SHA:0:7}."
  echo "  ⚠ $skipped default reviewer(s) were skipped — this was NOT a full cross-review." >&2
else
  relay_log "verdict exit=0 clean: $ran/$ran posted"
  echo "✔ Relay done — $ran/$ran reviewer(s) posted, reviewed sha ${HEAD_SHA:0:7}."
fi
echo "  This confirms every reviewer RAN, not that the PR is approved: read the reviews and"
echo "  resolve every Blocker/Should-fix before merging."
echo "  run log: $RUN_BASE"
exit 0
